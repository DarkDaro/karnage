{
  "name": "karnage-game",
  "version": "0.1.0",
  "private": true,
  "description": "KARNAGE — браузерный файтинг на Canvas 2D",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/serve.mjs",
    "assets:build": "py -3.14 tools/assets_import.py",
    "build": "node tools/build.mjs",
    "pretest": "npm run build",
    "test": "node --test",
    "test:unit": "node --test tests/unit/data.test.mjs tests/unit/text.test.mjs tests/unit/balance.test.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --test tests/e2e/smoke.test.mjs tests/e2e/release.test.mjs tests/e2e/regressions.test.mjs tests/e2e/fx.test.mjs tests/e2e/mobile.test.mjs tests/e2e/movesets.test.mjs",
    "audit": "py -3.14 tools/audit.py --check",
    "audit:fix-bom": "py -3.14 tools/audit.py --fix-bom",
    "audit:write-roster": "py -3.14 tools/audit.py --write-roster",
    "lint": "eslint tools tests src",
    "check": "node tools/check.mjs && npm run lint && npm run audit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "playwright": "^1.64.0"
  }
}
